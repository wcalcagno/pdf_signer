<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador MSI para Windows.

  Se instala por usuario (Scope="perUser") y no en Archivos de programa. Es deliberado:
  así no hace falta ser administrador, que para una herramienta de escritorio de uso
  personal elimina la principal fricción de instalación, sobre todo en equipos
  corporativos donde el usuario no tiene privilegios de administrador.

  La aplicación se publica autocontenida, de modo que el MSI no exige tener instalado
  .NET ni el Windows App SDK en la máquina de destino.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="PdfSigner"
           Manufacturer="Walter E. Calcagno Lucares"
           Version="$(var.Version)"
           UpgradeCode="7B3E9C42-5A81-4D6E-9F2B-0C8A1D4E7F35"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <!-- Instalar una versión nueva encima reemplaza a la anterior en vez de duplicarla. -->
    <MajorUpgrade DowngradeErrorMessage="Ya tienes instalada una versión más reciente de PdfSigner." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Datos que aparecen en "Aplicaciones instaladas" de Windows. -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/wcalcagno/pdf_signer" />
    <Property Id="ARPHELPLINK" Value="https://github.com/wcalcagno/pdf_signer/issues" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="PdfSigner">
        <!-- Recoge de golpe los 431 archivos de la publicación autocontenida. -->
        <Files Include="$(var.PublishDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AccesoDirectoMenuInicio" Guid="4F1A8D93-6E27-4B5C-A0D8-2E9B7C351A64">
        <Shortcut Id="AccesoMenuInicio"
                  Name="PdfSigner"
                  Description="Firma PDFs con tu imagen de firma y un bloque de texto"
                  Target="[INSTALLFOLDER]PdfSigner.App.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <!-- En una instalación por usuario el KeyPath debe ser HKCU: sin esta entrada
             el instalador no sabría si el acceso directo sigue puesto. -->
        <RegistryValue Root="HKCU"
                       Key="Software\PdfSigner"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
  </Package>
</Wix>
