<?xml version="1.0" encoding="utf-8" ?>
<!--
    Inspector de propiedades del elemento seleccionado.

    Es UNA sola vista para las dos disposiciones: en escritorio la coloca MainPage como
    columna fija a la derecha, y en móvil como panel inferior. La vista no sabe cuál de las
    dos es, y esa es justamente la idea: la diferencia es dónde se coloca, no qué muestra.

    Hereda el BindingContext de MainPage, o sea el MainViewModel.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PdfSigner.App.ViewModels"
             x:Class="PdfSigner.App.Views.ElementInspector"
             x:DataType="vm:MainViewModel">

    <Border Style="{StaticResource RegionInspector}">
        <Grid RowDefinitions="Auto,*">

            <Label Grid.Row="0"
                   Text="PROPIEDADES"
                   Style="{StaticResource EtiquetaSeccion}"
                   Margin="0,0,0,10" />

            <!-- Estado vacío. En escritorio el inspector no se oculta nunca: mostrar un
                 mensaje es preferible a dejar un hueco gris, y evita que el canvas cambie
                 de ancho al seleccionar, que es justo lo que hacía mal la versión anterior. -->
            <VerticalStackLayout Grid.Row="1"
                                 VerticalOptions="Center"
                                 Spacing="6"
                                 IsVisible="{Binding HasNoSelection}">
                <Label Text="Selecciona un elemento"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextoTenue}"
                       FontSize="13" />
                <Label Text="Toca una firma o un bloque de texto sobre la página para ver sus propiedades."
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextoTenue}"
                       FontSize="11" />
            </VerticalStackLayout>

            <!-- Propiedades del elemento seleccionado. -->
            <ScrollView Grid.Row="1" IsVisible="{Binding HasSelection}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{Binding SelectedKindLabel}"
                           FontSize="13"
                           FontAttributes="Bold" />

                    <!-- Bloque de texto. -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding SelectedIsText}">

                        <!--
                            Resumen plegado. Un Editor multilínea siempre desplegado se comía
                            media columna para algo que se escribe una vez y luego se deja
                            quieto; aquí ocupa dos líneas hasta que se pide editarlo.
                        -->
                        <Border IsVisible="{Binding IsNotEditingText}"
                                Padding="10,8"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Separador}, Dark={StaticResource SeparadorOscuro}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding SelectedTextSummary}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SelectedTextDetail}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextoTenue}" />
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Editar texto"
                                Command="{Binding ToggleTextEditCommand}"
                                FontSize="12"
                                HeightRequest="36"
                                IsVisible="{Binding IsNotEditingText}" />

                        <!-- Edición completa, bajo demanda. -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEditingText}">
                            <Editor Text="{Binding SelectedText, Mode=TwoWay}"
                                    Placeholder="Nombre, cargo, {fecha}..."
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="110"
                                    MaxLength="500" />
                            <Label Text="Puedes usar {fecha}, {hora} y {fechalarga}. Se sustituyen al exportar."
                                   FontSize="10"
                                   TextColor="{StaticResource TextoTenue}" />
                            <Button Text="Listo"
                                    Command="{Binding ToggleTextEditCommand}"
                                    FontSize="12"
                                    HeightRequest="36" />
                        </VerticalStackLayout>

                        <Label Text="TAMAÑO" Style="{StaticResource EtiquetaSeccion}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Stepper Grid.Column="0"
                                     Minimum="6" Maximum="48" Increment="1"
                                     Value="{Binding SelectedFontSizePt, Mode=TwoWay}" />
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedFontSizePt, StringFormat='{0:F0} pt'}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   FontSize="13" />
                        </Grid>

                        <!--
                            Paleta de color. Sustituye al campo hexadecimal que había antes:
                            pedir "#14145A" a quien solo quiere firmar un contrato es pedirle
                            un formato que no tiene por qué conocer.

                            Se usa BindableLayout sobre un FlexLayout y no un CollectionView.
                            Son ocho elementos fijos, no hace falta virtualizar, y en este
                            proyecto CollectionView ya dio un fallo silencioso al colocarlo en
                            un contenedor sin tamaño definido.
                        -->
                        <Label Text="COLOR" Style="{StaticResource EtiquetaSeccion}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding ColorSwatches}"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorSwatchViewModel">
                                    <Border Margin="0,0,8,8"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Padding="0"
                                            BackgroundColor="{Binding Color}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="{Binding BorderThickness}"
                                            SemanticProperties.Description="{Binding Nombre}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSwatchTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Button Text="Otro color…"
                                Command="{Binding ToggleCustomColorCommand}"
                                FontSize="12"
                                HeightRequest="34" />

                        <!--
                            Tres deslizadores en vez de un selector nativo: MAUI no tiene
                            ninguno, y no existe API multiplataforma para ello.
                        -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsCustomColorOpen}">
                            <Border HeightRequest="26"
                                    BackgroundColor="{Binding SelectedColorPreview}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Separador}, Dark={StaticResource SeparadorOscuro}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                            </Border>
                            <Label Text="Rojo" FontSize="10" TextColor="{StaticResource TextoTenue}" />
                            <Slider Minimum="0" Maximum="255" Value="{Binding ColorR, Mode=TwoWay}" />
                            <Label Text="Verde" FontSize="10" TextColor="{StaticResource TextoTenue}" />
                            <Slider Minimum="0" Maximum="255" Value="{Binding ColorG, Mode=TwoWay}" />
                            <Label Text="Azul" FontSize="10" TextColor="{StaticResource TextoTenue}" />
                            <Slider Minimum="0" Maximum="255" Value="{Binding ColorB, Mode=TwoWay}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Imagen de firma. -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding SelectedIsImage}">
                        <Label Text="Arrastra la imagen para moverla y usa las esquinas para cambiar su tamaño."
                               FontSize="11"
                               TextColor="{StaticResource TextoTenue}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding SelectedPageLabel}"
                           FontSize="11"
                           TextColor="{StaticResource TextoTenue}" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</ContentView>
