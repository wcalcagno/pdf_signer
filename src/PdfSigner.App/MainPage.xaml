<?xml version="1.0" encoding="utf-8" ?>
<!--
    Pantalla principal, organizada en cuatro regiones:

        Barra superior  · acciones que siempre están disponibles
        Canvas          · la página, con una capa superpuesta para lo contextual
        Inspector       · propiedades del elemento seleccionado
        Navegador       · miniaturas de páginas y estado

    Un solo árbol de vistas para las cuatro plataformas. Lo único que cambia entre
    escritorio y móvil es DÓNDE se coloca el inspector, y de eso se encarga el code-behind
    moviéndolo de celda, en vez de duplicar la vista entera.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PdfSigner.App.ViewModels"
             xmlns:views="clr-namespace:PdfSigner.App.Views"
             x:Class="PdfSigner.App.MainPage"
             x:DataType="vm:MainViewModel"
             Title="PdfSigner">

    <!--
        Aquí se declara la disposición de ESCRITORIO: 3 filas y 2 columnas, con el inspector
        en la columna derecha. La variante de móvil la aplica el code-behind.

        La reorganización para móvil se hace en code-behind y no con OnIdiom sobre
        RowDefinitions o ColumnDefinitions. OnIdiom sobre propiedades que necesitan conversor
        de tipo es terreno resbaladizo, y aquí no se puede comprobar: esta máquina solo
        compila y ejecuta Windows. Un cambio explícito en código es verificable leyéndolo.
    -->
    <Grid x:Name="RaizGrid"
          RowSpacing="0" ColumnSpacing="0"
          ColumnDefinitions="*,220"
          RowDefinitions="Auto,*,Auto">

        <!-- ============================================ REGIÓN 1: barra superior -->
        <Grid x:Name="BarraSuperior"
              Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Style="{StaticResource RegionBarra}"
              ColumnDefinitions="*,Auto">

            <!--
                Acciones de creación. Van en un ScrollView horizontal para que en una pantalla
                estrecha se desplacen en lugar de recortarse o apilarse.

                "Usar favorita" se queda aquí y no pasa a la barra contextual: coloca una firma
                nueva, así que hace falta justamente cuando NO hay nada seleccionado. En una
                barra que solo aparece con selección sería inalcanzable.
            -->
            <ScrollView Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Abrir PDF" Command="{Binding OpenPdfCommand}" />
                    <Button Text="Añadir firma" Command="{Binding AddImageCommand}" IsEnabled="{Binding HasDocument}" />
                    <Button Text="Añadir texto" Command="{Binding AddTextCommand}" IsEnabled="{Binding HasDocument}" />
                    <Button Text="Usar favorita" Command="{Binding ApplyFavoriteCommand}" IsEnabled="{Binding HasDocument}" />
                </HorizontalStackLayout>
            </ScrollView>

            <!--
                Deshacer y Exportar quedan fuera del ScrollView, anclados a la derecha: son las
                dos acciones que nunca deben poder quedarse fuera de la vista.
            -->
            <HorizontalStackLayout Grid.Column="1" Spacing="8" Margin="8,0,0,0" VerticalOptions="Center">
                <Button Text="↶"
                        Command="{Binding UndoCommand}"
                        WidthRequest="48"
                        SemanticProperties.Description="Deshacer el último cambio"
                        ToolTipProperties.Text="Deshacer" />
                <Button Text="Exportar"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding HasDocument}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ================================================== REGIÓN 2: canvas -->
        <!--
            Dos capas en la MISMA celda. La capa 1 lleva el zoom; la capa 2 no, y por eso
            lo que se ponga en ella (fase 3) conserva su tamaño real sea cual sea la
            ampliación de la página.
        -->
        <Grid x:Name="RegionCanvas" Grid.Row="1" Grid.Column="0"
              Style="{StaticResource RegionCanvas}"
              SizeChanged="OnCanvasResized">

            <!-- Capa 1: la página, con desplazamiento y zoom. -->
            <ScrollView Orientation="Both">
                <Grid Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
                    <!--
                        El zoom cambia el TAMAÑO de la página, no su Scale. Scale no afecta al
                        layout: el hueco seguiría midiendo lo original, el ScrollView calcularía
                        mal su recorrido y la página se dibujaría estirada. Además, con tamaño
                        real los bordes de selección y las asas no se escalan y conservan su
                        tamaño en pantalla a cualquier ampliación.
                    -->
                    <Grid x:Name="PageHost"
                          WidthRequest="{Binding DisplayWidth}"
                          HeightRequest="{Binding DisplayHeight}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">

                        <Image Source="{Binding CurrentPageImage}" Aspect="Fill" />

                        <Grid BindableLayout.ItemsSource="{Binding VisibleElements}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ElementViewModel">
                                    <!--
                                        Este contenedor es MAYOR que el elemento: se extiende
                                        un radio de asa por cada lado, y el elemento va dentro
                                        con ese mismo margen.

                                        No es un capricho de maquetación. Las asas se centran
                                        sobre las esquinas, así que la mitad de cada una cae
                                        fuera del elemento. Dibujar fuera del contenedor
                                        funciona, pero los CLICS en esa zona no: el hit-testing
                                        no sale de los límites del padre. Con el contenedor
                                        pequeño solo respondía el cuarto interior de cada asa,
                                        que además compite con el gesto de mover, y agarrar una
                                        esquina costaba varios intentos.
                                    -->
                                    <Grid Margin="{Binding HitPosition}"
                                          WidthRequest="{Binding HitWidth}"
                                          HeightRequest="{Binding HitHeight}"
                                          HorizontalOptions="Start"
                                          VerticalOptions="Start">

                                        <!-- Scale y Opacity van en el Border y no en el Grid
                                             exterior: escalar el Grid movería también las asas
                                             respecto de las esquinas, justo mientras se está
                                             apuntando a ellas. -->
                                        <Border Margin="{Binding HitPadding}"
                                                BackgroundColor="Transparent"
                                                Stroke="{Binding OutlineColor}"
                                                StrokeThickness="{Binding OutlineThickness}"
                                                Scale="{Binding ContentScale}"
                                                Opacity="{Binding ContentOpacity}">

                                            <Border.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnElementPan" />
                                                <TapGestureRecognizer Tapped="OnElementTapped" />
                                            </Border.GestureRecognizers>

                                            <Grid>
                                                <Image Source="{Binding Preview}"
                                                       Aspect="Fill"
                                                       IsVisible="{Binding IsImage}" />

                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="{Binding FontSize}"
                                                       TextColor="{Binding TextColor}"
                                                       IsVisible="{Binding IsText}"
                                                       LineBreakMode="WordWrap" />
                                            </Grid>
                                        </Border>

                                        <!--
                                            Una asa por esquina. ClassId identifica cuál es:
                                            dentro de una plantilla no se puede usar x:Name, y
                                            los gestos de MAUI no admiten parámetro, así que el
                                            manejador lo lee de ahí.

                                            El margen de -22 centra el área táctil de 44 sobre
                                            la esquina, de modo que se puede agarrar tanto por
                                            dentro como por fuera del elemento.
                                        -->
                                        <Grid ClassId="TopLeft"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="Start" VerticalOptions="Start"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>

                                        <Grid ClassId="TopRight"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="End" VerticalOptions="Start"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>

                                        <Grid ClassId="BottomLeft"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="Start" VerticalOptions="End"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>

                                        <Grid ClassId="BottomRight"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="End" VerticalOptions="End"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <Grid.GestureRecognizers>
                            <PinchGestureRecognizer PinchUpdated="OnPagePinch" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>
            </ScrollView>

            <!--
                Capa 2: superposiciones sobre la página.

                InputTransparent con CascadeInputTransparent="False" es la combinación que hace
                falta: la capa en sí deja pasar los clics a la página que tiene debajo, pero sus
                hijos sí los reciben. Sin desactivar la cascada, la barra flotante sería
                decorativa y no respondería a nada.
            -->
            <Grid x:Name="CapaFlotante" InputTransparent="True" CascadeInputTransparent="False">

                <!--
                    Barra contextual. Va anclada y centrada, NO junto al elemento seleccionado.
                    Colocarla junto al elemento obligaría a traducir coordenadas de página a
                    pantalla contando zoom y desplazamiento del ScrollView, saldría fuera de la
                    vista al arrastrar hacia un borde, y daría saltos mientras se mueve la firma.

                    Anclada ABAJO y no arriba: probando con un acta real se vio que arriba
                    tapaba las primeras líneas del documento, que es justo donde suele estar el
                    encabezado que hace falta leer para saber qué se está firmando. La parte
                    baja del lienzo suele ser margen.
                -->
                <Border IsVisible="{Binding HasSelection}"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,0,0,14"
                        Padding="6"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Separador}, Dark={StaticResource SeparadorOscuro}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FondoBarra}, Dark={StaticResource FondoBarraOscuro}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding SelectedKindLabel}"
                               FontSize="12"
                               VerticalOptions="Center"
                               Margin="8,0,4,0"
                               TextColor="{StaticResource TextoTenue}" />

                        <Button Text="Guardar favorita"
                                Command="{Binding SaveFavoriteCommand}"
                                FontSize="12"
                                Padding="12,4"
                                HeightRequest="34" />

                        <Button Text="Eliminar"
                                Command="{Binding DeleteSelectedCommand}"
                                FontSize="12"
                                Padding="12,4"
                                HeightRequest="34" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Aviso cuando todavía no hay documento. -->
            <Label Text="Abre un PDF para empezar"
                   TextColor="White"
                   FontSize="15"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding HasNoDocument}" />
        </Grid>

        <!-- =============================================== REGIÓN 3: inspector -->
        <!--
            Misma vista, dos ubicaciones. En escritorio ocupa la columna derecha y se ve
            siempre, con su estado vacío. En móvil es una fila bajo el canvas que solo
            aparece cuando hay algo seleccionado.
        -->
        <views:ElementInspector x:Name="Inspector"
                                Grid.Row="1"
                                Grid.Column="1"
                                IsVisible="{Binding InspectorVisible}" />

        <!-- =============================================== REGIÓN 4: navegador -->
        <Grid x:Name="RegionNavegador"
              Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Style="{StaticResource RegionNavegador}"
              RowDefinitions="Auto,Auto">

            <!--
                El CollectionView va envuelto en un contenedor de altura definida a propósito.
                Colocado directamente en una fila Auto no se dibujaba, y arrastraba consigo a
                la barra de estado, que quedaba en blanco. CollectionView necesita que su
                contenedor tenga un tamaño concreto; con Auto no sabe cuánto medir.
            -->
            <Grid Grid.Row="0"
                  HeightRequest="{StaticResource AltoNavegadorPaginas}"
                  IsVisible="{Binding HasDocument}">

                <CollectionView ItemsSource="{Binding Pages}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageViewModel">
                            <VerticalStackLayout Padding="8,6" Spacing="2">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPageTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Image Source="{Binding Thumbnail}" HeightRequest="80" Aspect="AspectFit" />
                                <Label Text="{Binding Label}" HorizontalOptions="Center" FontSize="12" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- La barra de estado se integra aquí en vez de ser una quinta franja propia.
                 Lleva color de fondo propio para no depender de que el estilo del padre se
                 resuelva bien, que es lo que fallaba. -->
            <Grid Grid.Row="1"
                  Padding="12,8"
                  ColumnDefinitions="*,Auto"
                  MinimumHeightRequest="34"
                  BackgroundColor="{AppThemeBinding Light={StaticResource FondoNavegador}, Dark={StaticResource FondoNavegadorOscuro}}">
                <Label Text="{Binding Status}" Style="{StaticResource EtiquetaEstado}" />
                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HeightRequest="16" WidthRequest="16" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
