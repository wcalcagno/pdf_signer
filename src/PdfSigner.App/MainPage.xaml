<?xml version="1.0" encoding="utf-8" ?>
<!--
    Pantalla principal, organizada en cuatro regiones:

        Barra superior  · acciones que siempre están disponibles
        Canvas          · la página, con una capa superpuesta para lo contextual
        Inspector       · propiedades del elemento seleccionado
        Navegador       · miniaturas de páginas y estado

    Un solo árbol de vistas para las cuatro plataformas. Lo único que cambia entre
    escritorio y móvil es DÓNDE se coloca el inspector, y de eso se encarga el code-behind
    moviéndolo de celda, en vez de duplicar la vista entera.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PdfSigner.App.ViewModels"
             xmlns:views="clr-namespace:PdfSigner.App.Views"
             x:Class="PdfSigner.App.MainPage"
             x:DataType="vm:MainViewModel"
             Title="PdfSigner">

    <!--
        Plantillas de las zonas rellenables del formulario.

        Todas comparten la misma forma de colocarse: margen para la posición y tamaño pedido,
        anclados arriba a la izquierda. Es el mismo mecanismo que usan las firmas, y por el
        mismo motivo: el posicionamiento proporcional de AbsoluteLayout tiene en cuenta el
        tamaño del propio control, así que no cuadraría con el PDF exportado.

        El realce de fondo es deliberado. Un campo de formulario vacío es invisible sobre la
        página —en el papel lo marca una línea impresa, aquí no hay nada— y sin él el usuario
        no tendría forma de saber que el documento se puede rellenar.
    -->
    <ContentPage.Resources>

        <!--
            Cada campo de escritura tiene DOS caras: una etiqueta que muestra el valor y el
            control nativo, que solo aparece al tocarlo.

            No es un capricho. En Windows, un Entry mas bajo de unos 24 pixeles pinta su fondo
            pero no su texto, y con la pagina ajustada a la ventana un campo de 20 puntos mide
            quince. El formulario se veia vacio aunque los valores estuvieran puestos, que es
            la peor forma de fallar: no hay error, solo un documento en blanco. Una etiqueta
            se encoge a la medida real del campo sin dejar de verse.
        -->
        <DataTemplate x:Key="CampoTexto" x:DataType="vm:FormFieldViewModel">
            <Grid Margin="{Binding Position}"
                  WidthRequest="{Binding Width}"
                  HeightRequest="{Binding Height}"
                  HorizontalOptions="Start"
                  VerticalOptions="Start">

                <Border IsVisible="{Binding IsNotEditing}"
                        Padding="2,0"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource RealceCampo}"
                        SemanticProperties.Description="{Binding Placeholder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFormFieldEdit" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding DisplayText}"
                           FontSize="{Binding FontSize}"
                           TextColor="{Binding DisplayColor}"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                </Border>

                <Entry IsVisible="{Binding IsEditing}"
                       Text="{Binding Text, Mode=TwoWay}"
                       Placeholder="{Binding Placeholder}"
                       FontSize="{Binding FontSize}"
                       TextColor="{StaticResource TintaCampo}"
                       PlaceholderColor="{StaticResource TextoTenue}"
                       HeightRequest="{Binding EditHeight}"
                       MinimumHeightRequest="0"
                       VerticalOptions="Start"
                       BackgroundColor="{StaticResource RealceCampo}"
                       Unfocused="OnFormFieldEditDone" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CampoMultilinea" x:DataType="vm:FormFieldViewModel">
            <Grid Margin="{Binding Position}"
                  WidthRequest="{Binding Width}"
                  HeightRequest="{Binding Height}"
                  HorizontalOptions="Start"
                  VerticalOptions="Start">

                <Border IsVisible="{Binding IsNotEditing}"
                        Padding="2,0"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource RealceCampo}"
                        SemanticProperties.Description="{Binding Placeholder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFormFieldEdit" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding DisplayText}"
                           FontSize="{Binding FontSize}"
                           TextColor="{Binding DisplayColor}"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Start" />
                </Border>

                <Editor IsVisible="{Binding IsEditing}"
                        Text="{Binding Text, Mode=TwoWay}"
                        Placeholder="{Binding Placeholder}"
                        FontSize="{Binding FontSize}"
                        TextColor="{StaticResource TintaCampo}"
                        PlaceholderColor="{StaticResource TextoTenue}"
                        HeightRequest="{Binding EditHeight}"
                        MinimumHeightRequest="0"
                        AutoSize="Disabled"
                        VerticalOptions="Start"
                        BackgroundColor="{StaticResource RealceCampo}"
                        Unfocused="OnFormFieldEditDone" />
            </Grid>
        </DataTemplate>

        <!--
            Casillas y radios se dibujan a mano en vez de usar CheckBox y RadioButton de MAUI.
            Esos controles traen su propio tamaño fijo y no se pueden encoger hasta la medida
            real del campo, que en un formulario suele ser de unos pocos milímetros: saldrían
            desbordados sobre el texto de alrededor. Un Border con su marca dentro sí escala.
        -->
        <DataTemplate x:Key="CampoBoton" x:DataType="vm:FormFieldViewModel">
            <Border Margin="{Binding Position}"
                    WidthRequest="{Binding Width}"
                    HeightRequest="{Binding Height}"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Padding="0"
                    StrokeThickness="1"
                    Stroke="{StaticResource BordeCampo}"
                    BackgroundColor="{StaticResource RealceCampo}"
                    SemanticProperties.Description="{Binding Placeholder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFormFieldToggled" />
                </Border.GestureRecognizers>
                <Label Text="{Binding Glyph}"
                       FontSize="{Binding GlyphSize}"
                       TextColor="{StaticResource TintaCampo}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </DataTemplate>

        <!--
            El desplegable tambien se dibuja a mano y al tocarlo se abre una hoja de opciones.

            Se probo antes con el Picker de MAUI y no muestra la opcion elegida: se le asigne
            por SelectedItem o por SelectedIndex, y tanto desde el enlace como desde codigo al
            cargarse, el control sigue enseñando su titulo. Ademas obliga a darle un alto
            minimo mayor que el del campo para que se le vea el texto. La hoja de opciones es
            ademas mas usable en un campo de pocos milimetros, donde una lista desplegable
            nativa resulta imposible de acertar con el dedo.
        -->
        <DataTemplate x:Key="CampoEleccion" x:DataType="vm:FormFieldViewModel">
            <Border Margin="{Binding Position}"
                    WidthRequest="{Binding Width}"
                    HeightRequest="{Binding Height}"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Padding="2,0"
                    StrokeThickness="1"
                    Stroke="{StaticResource BordeCampo}"
                    BackgroundColor="{StaticResource RealceCampo}"
                    SemanticProperties.Description="{Binding Placeholder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFormChoiceTapped" />
                </Border.GestureRecognizers>
                <Label Text="{Binding DisplayText}"
                       FontSize="{Binding FontSize}"
                       TextColor="{Binding DisplayColor}"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />
            </Border>
        </DataTemplate>

        <views:FormFieldTemplateSelector x:Key="SelectorDeCampo"
                                         Texto="{StaticResource CampoTexto}"
                                         Multilinea="{StaticResource CampoMultilinea}"
                                         Boton="{StaticResource CampoBoton}"
                                         Eleccion="{StaticResource CampoEleccion}" />
    </ContentPage.Resources>

    <!--
        Aquí se declara la disposición de ESCRITORIO: 3 filas y 2 columnas, con el inspector
        en la columna derecha. La variante de móvil la aplica el code-behind.

        La reorganización para móvil se hace en code-behind y no con OnIdiom sobre
        RowDefinitions o ColumnDefinitions. OnIdiom sobre propiedades que necesitan conversor
        de tipo es terreno resbaladizo, y aquí no se puede comprobar: esta máquina solo
        compila y ejecuta Windows. Un cambio explícito en código es verificable leyéndolo.
    -->
    <Grid x:Name="RaizGrid"
          RowSpacing="0" ColumnSpacing="0"
          ColumnDefinitions="*,220"
          RowDefinitions="Auto,*,Auto">

        <!-- ============================================ REGIÓN 1: barra superior -->
        <Grid x:Name="BarraSuperior"
              Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Style="{StaticResource RegionBarra}"
              ColumnDefinitions="*,Auto">

            <!--
                Acciones de creación. Van en un ScrollView horizontal para que en una pantalla
                estrecha se desplacen en lugar de recortarse o apilarse.

                "Usar favorita" se queda aquí y no pasa a la barra contextual: coloca una firma
                nueva, así que hace falta justamente cuando NO hay nada seleccionado. En una
                barra que solo aparece con selección sería inalcanzable.
            -->
            <ScrollView Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Abrir PDF" Command="{Binding OpenPdfCommand}" />
                    <Button Text="Añadir firma" Command="{Binding AddImageCommand}" IsEnabled="{Binding HasDocument}" />
                    <Button Text="Añadir texto" Command="{Binding AddTextCommand}" IsEnabled="{Binding HasDocument}" />
                    <Button Text="Usar favorita" Command="{Binding ApplyFavoriteCommand}" IsEnabled="{Binding HasDocument}" />
                </HorizontalStackLayout>
            </ScrollView>

            <!--
                Deshacer y Exportar quedan fuera del ScrollView, anclados a la derecha: son las
                dos acciones que nunca deben poder quedarse fuera de la vista.
            -->
            <HorizontalStackLayout Grid.Column="1" Spacing="8" Margin="8,0,0,0" VerticalOptions="Center">

                <!--
                    Solo aparece si el documento trae formulario: en un PDF normal no hay
                    campos que bloquear y la opción sería ruido.

                    Va pegada a Exportar y no en el inspector porque describe cómo va a salir
                    el archivo, no una propiedad de nada seleccionado; y porque es una decisión
                    que se toma justo antes de exportar, no mientras se rellena.
                -->
                <HorizontalStackLayout Spacing="4"
                                       IsVisible="{Binding HasForm}"
                                       VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLockFieldsCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>

                    <CheckBox IsChecked="{Binding LockFieldsOnExport, Mode=TwoWay}"
                              VerticalOptions="Center"
                              SemanticProperties.Description="Bloquear los campos al exportar" />

                    <Label Text="Bloquear campos al exportar"
                           FontSize="12"
                           VerticalOptions="Center"
                           ToolTipProperties.Text="El PDF exportado conserva lo escrito pero ya no se puede editar." />
                </HorizontalStackLayout>

                <Button Text="↶"
                        Command="{Binding UndoCommand}"
                        WidthRequest="48"
                        SemanticProperties.Description="Deshacer el último cambio"
                        ToolTipProperties.Text="Deshacer" />
                <Button Text="Exportar"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding HasDocument}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ================================================== REGIÓN 2: canvas -->
        <!--
            Dos capas en la MISMA celda. La capa 1 lleva el zoom; la capa 2 no, y por eso
            lo que se ponga en ella (fase 3) conserva su tamaño real sea cual sea la
            ampliación de la página.
        -->
        <Grid x:Name="RegionCanvas" Grid.Row="1" Grid.Column="0"
              Style="{StaticResource RegionCanvas}"
              SizeChanged="OnCanvasResized">

            <!-- El gris de alrededor tambien deselecciona: para quien mira, todo lo que no
                 sea la firma es "fuera". -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCanvasTapped" />
            </Grid.GestureRecognizers>

            <!-- Capa 1: la página, con desplazamiento y zoom. -->
            <ScrollView x:Name="CanvasScroll" Orientation="Both">
                <!--
                    El toque en el fondo deselecciona. Sin esto, la barra flotante se queda
                    sobre el documento tapando texto hasta que se elige otra cosa, y lo que
                    hace cualquiera para quitarla es pinchar fuera.

                    Va en este contenedor y no en el de la pagina para que valga tambien el
                    margen gris de alrededor.
                -->
                <Grid Padding="24"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCanvasTapped" />
                    </Grid.GestureRecognizers>
                    <!--
                        El zoom cambia el TAMAÑO de la página, no su Scale. Scale no afecta al
                        layout: el hueco seguiría midiendo lo original, el ScrollView calcularía
                        mal su recorrido y la página se dibujaría estirada. Además, con tamaño
                        real los bordes de selección y las asas no se escalan y conservan su
                        tamaño en pantalla a cualquier ampliación.
                    -->
                    <Grid x:Name="PageHost"
                          WidthRequest="{Binding DisplayWidth}"
                          HeightRequest="{Binding DisplayHeight}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">

                        <Image Source="{Binding CurrentPageImage}" Aspect="Fill" />

                        <!--
                            Los campos del formulario van DEBAJO de las firmas. Forman parte
                            del documento, mientras que una firma se estampa encima; si una
                            firma acaba sobre un campo, el gesto tiene que ir a la firma, que
                            es lo que el usuario está moviendo.
                        -->
                        <Grid BindableLayout.ItemsSource="{Binding VisibleFormFields}"
                              BindableLayout.ItemTemplateSelector="{StaticResource SelectorDeCampo}" />

                        <Grid BindableLayout.ItemsSource="{Binding VisibleElements}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ElementViewModel">
                                    <!--
                                        Este contenedor es MAYOR que el elemento: se extiende
                                        un radio de asa por cada lado, y el elemento va dentro
                                        con ese mismo margen.

                                        No es un capricho de maquetación. Las asas se centran
                                        sobre las esquinas, así que la mitad de cada una cae
                                        fuera del elemento. Dibujar fuera del contenedor
                                        funciona, pero los CLICS en esa zona no: el hit-testing
                                        no sale de los límites del padre. Con el contenedor
                                        pequeño solo respondía el cuarto interior de cada asa,
                                        que además compite con el gesto de mover, y agarrar una
                                        esquina costaba varios intentos.
                                    -->
                                    <Grid Margin="{Binding HitPosition}"
                                          WidthRequest="{Binding HitWidth}"
                                          HeightRequest="{Binding HitHeight}"
                                          HorizontalOptions="Start"
                                          VerticalOptions="Start">

                                        <!-- Scale y Opacity van en el Border y no en el Grid
                                             exterior: escalar el Grid movería también las asas
                                             respecto de las esquinas, justo mientras se está
                                             apuntando a ellas. -->
                                        <Border Margin="{Binding HitPadding}"
                                                BackgroundColor="Transparent"
                                                Stroke="{Binding OutlineColor}"
                                                StrokeThickness="{Binding OutlineThickness}"
                                                Scale="{Binding ContentScale}"
                                                Opacity="{Binding ContentOpacity}">

                                            <Border.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnElementPan" />
                                                <TapGestureRecognizer Tapped="OnElementTapped" />
                                            </Border.GestureRecognizers>

                                            <Grid>
                                                <Image Source="{Binding Preview}"
                                                       Aspect="Fill"
                                                       IsVisible="{Binding IsImage}" />

                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="{Binding FontSize}"
                                                       TextColor="{Binding TextColor}"
                                                       IsVisible="{Binding IsNotEditing}"
                                                       LineBreakMode="WordWrap" />

                                            </Grid>
                                        </Border>


                                        <!--
                                            El editor va FUERA del Border, como hermano suyo.
                                            Dentro queda recortado a la altura del bloque, y
                                            un bloque de una linea mide unos pocos pixeles con
                                            la pagina alejada: el editor se veia como una
                                            rendija y no se podia teclear en el. Aqui puede
                                            crecer hasta un alto legible sin tocar el tamaño
                                            real del elemento.

                                            Muestra el texto CRUDO, con {fecha} sin resolver,
                                            que es lo que hay que poder corregir; la etiqueta
                                            de dentro enseña como va a quedar.
                                        -->
                                        <Editor IsVisible="{Binding IsEditing}"
                                                Text="{Binding Text, Mode=TwoWay}"
                                                Placeholder="Escribe aquí"
                                                PlaceholderColor="{StaticResource TextoTenue}"
                                                FontSize="{Binding EditFontSize}"
                                                TextColor="{Binding TextColor}"
                                                Margin="{Binding HitPadding}"
                                                HeightRequest="{Binding EditHeight}"
                                                MinimumHeightRequest="0"
                                                AutoSize="Disabled"
                                                VerticalOptions="Start"
                                                BackgroundColor="{StaticResource RealceCampo}"
                                                Loaded="OnElementEditorLoaded"
                                                Unfocused="OnElementEditDone" />
                                        <!--
                                            Una asa por esquina. ClassId identifica cuál es:
                                            dentro de una plantilla no se puede usar x:Name, y
                                            los gestos de MAUI no admiten parámetro, así que el
                                            manejador lo lee de ahí.

                                            El margen de -22 centra el área táctil de 44 sobre
                                            la esquina, de modo que se puede agarrar tanto por
                                            dentro como por fuera del elemento.
                                        -->
                                        <Grid ClassId="TopLeft"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="Start" VerticalOptions="Start"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>

                                        <Grid ClassId="TopRight"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="End" VerticalOptions="Start"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>

                                        <Grid ClassId="BottomLeft"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="Start" VerticalOptions="End"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>

                                        <Grid ClassId="BottomRight"
                                              Style="{StaticResource AreaAsa}"
                                              IsVisible="{Binding IsSelected}"
                                              HorizontalOptions="End" VerticalOptions="End"
                                              Margin="0">
                                            <Grid.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnHandlePan" />
                                            </Grid.GestureRecognizers>
                                            <BoxView Style="{StaticResource PuntoAsa}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <Grid.GestureRecognizers>
                            <PinchGestureRecognizer PinchUpdated="OnPagePinch" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>
            </ScrollView>

            <!--
                Capa 2: superposiciones sobre la página.

                InputTransparent con CascadeInputTransparent="False" es la combinación que hace
                falta: la capa en sí deja pasar los clics a la página que tiene debajo, pero sus
                hijos sí los reciben. Sin desactivar la cascada, la barra flotante sería
                decorativa y no respondería a nada.
            -->
            <Grid x:Name="CapaFlotante" InputTransparent="True" CascadeInputTransparent="False">

                <!--
                    Barra contextual. Va anclada y centrada, NO junto al elemento seleccionado.
                    Colocarla junto al elemento obligaría a traducir coordenadas de página a
                    pantalla contando zoom y desplazamiento del ScrollView, saldría fuera de la
                    vista al arrastrar hacia un borde, y daría saltos mientras se mueve la firma.

                    Anclada ABAJO y no arriba: probando con un acta real se vio que arriba
                    tapaba las primeras líneas del documento, que es justo donde suele estar el
                    encabezado que hace falta leer para saber qué se está firmando. La parte
                    baja del lienzo suele ser margen.
                -->
                <Border IsVisible="{Binding HasSelection}"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,0,0,14"
                        Padding="6"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Separador}, Dark={StaticResource SeparadorOscuro}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource FondoBarra}, Dark={StaticResource FondoBarraOscuro}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding SelectedKindLabel}"
                               FontSize="12"
                               VerticalOptions="Center"
                               Margin="8,0,4,0"
                               TextColor="{StaticResource TextoTenue}" />

                        <Button Text="Guardar favorita"
                                Command="{Binding SaveFavoriteCommand}"
                                FontSize="12"
                                Padding="12,4"
                                HeightRequest="34" />

                        <Button Text="Eliminar"
                                Command="{Binding DeleteSelectedCommand}"
                                FontSize="12"
                                Padding="12,4"
                                HeightRequest="34" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Aviso cuando todavía no hay documento. -->
            <Label Text="Abre un PDF para empezar"
                   TextColor="White"
                   FontSize="15"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding HasNoDocument}" />
        </Grid>

        <!-- =============================================== REGIÓN 3: inspector -->
        <!--
            Misma vista, dos ubicaciones. En escritorio ocupa la columna derecha y se ve
            siempre, con su estado vacío. En móvil es una fila bajo el canvas que solo
            aparece cuando hay algo seleccionado.
        -->
        <views:ElementInspector x:Name="Inspector"
                                Grid.Row="1"
                                Grid.Column="1"
                                IsVisible="{Binding InspectorVisible}" />

        <!-- =============================================== REGIÓN 4: navegador -->
        <Grid x:Name="RegionNavegador"
              Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Style="{StaticResource RegionNavegador}"
              RowDefinitions="Auto,Auto">

            <!--
                El CollectionView va envuelto en un contenedor de altura definida a propósito.
                Colocado directamente en una fila Auto no se dibujaba, y arrastraba consigo a
                la barra de estado, que quedaba en blanco. CollectionView necesita que su
                contenedor tenga un tamaño concreto; con Auto no sabe cuánto medir.
            -->
            <Grid Grid.Row="0"
                  HeightRequest="{StaticResource AltoNavegadorPaginas}"
                  IsVisible="{Binding HasDocument}">

                <CollectionView ItemsSource="{Binding Pages}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageViewModel">
                            <VerticalStackLayout Padding="8,6" Spacing="2">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPageTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Image Source="{Binding Thumbnail}" HeightRequest="80" Aspect="AspectFit" />
                                <Label Text="{Binding Label}" HorizontalOptions="Center" FontSize="12" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- La barra de estado se integra aquí en vez de ser una quinta franja propia.
                 Lleva color de fondo propio para no depender de que el estilo del padre se
                 resuelva bien, que es lo que fallaba. -->
            <Grid Grid.Row="1"
                  Padding="12,8"
                  ColumnDefinitions="*,Auto,Auto"
                  MinimumHeightRequest="34"
                  BackgroundColor="{AppThemeBinding Light={StaticResource FondoNavegador}, Dark={StaticResource FondoNavegadorOscuro}}">
                <Label Text="{Binding Status}" Style="{StaticResource EtiquetaEstado}" />

                <!--
                    Los controles de zoom van aqui y no en la barra de arriba porque no son
                    una accion sobre el documento sino un ajuste de como se mira, igual que en
                    cualquier visor. Ademas la barra de arriba ya compite por sitio.

                    Hacen falta aunque exista el gesto de pellizco: en escritorio con raton no
                    hay pellizco, y Ctrl+rueda no se descubre solo.
                -->
                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="4"
                                       IsVisible="{Binding HasDocument}"
                                       VerticalOptions="Center">

                    <Button Text="−"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource BotonZoom}"
                            SemanticProperties.Description="Alejar"
                            ToolTipProperties.Text="Alejar (Ctrl + rueda del ratón)" />

                    <Label Text="{Binding ZoomLabel}"
                           FontSize="12"
                           WidthRequest="52"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           TextColor="{StaticResource TextoTenue}" />

                    <Button Text="+"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource BotonZoom}"
                            SemanticProperties.Description="Acercar"
                            ToolTipProperties.Text="Acercar (Ctrl + rueda del ratón)" />

                    <Button Text="Ajustar"
                            Command="{Binding ZoomResetCommand}"
                            FontSize="12"
                            Padding="10,0"
                            HeightRequest="26"
                            ToolTipProperties.Text="Encajar la página entera en la ventana" />
                </HorizontalStackLayout>

                <ActivityIndicator Grid.Column="2"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Margin="8,0,0,0"
                                   HeightRequest="16" WidthRequest="16" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
