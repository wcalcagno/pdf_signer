<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Estilos de las cuatro regiones de la pantalla principal.

    Están aquí y no repartidos por MainPage.xaml para que cambiar el aspecto de una región
    sea un solo cambio, y para que el XAML de la página se lea como una estructura y no
    como una lista de colores.

    Las medidas clave (ancho del inspector, alto del bottom sheet, tamaño del asa) son
    recursos con nombre porque también las usa el código: el asa, por ejemplo, se compensa
    con el zoom desde el ViewModel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Medidas -->
    <x:Double x:Key="AnchoInspector">220</x:Double>
    <x:Double x:Key="AltoBottomSheet">200</x:Double>
    <x:Double x:Key="AltoNavegadorPaginas">120</x:Double>
    <x:Double x:Key="LadoAsa">20</x:Double>

    <!-- El área táctil mínima recomendada por las guías de Apple y Google. Las asas se
         dibujan pequeñas pero se tocan en un cuadrado de este tamaño. -->
    <x:Double x:Key="LadoAreaTactil">44</x:Double>

    <!-- Colores por región -->
    <Color x:Key="FondoBarra">#F2F2F7</Color>
    <Color x:Key="FondoBarraOscuro">#1C1C1E</Color>
    <Color x:Key="FondoCanvas">#8E8E93</Color>
    <Color x:Key="FondoCanvasOscuro">#000000</Color>
    <Color x:Key="FondoInspector">#FAFAFC</Color>
    <Color x:Key="FondoInspectorOscuro">#232325</Color>
    <Color x:Key="FondoNavegador">#E5E5EA</Color>
    <Color x:Key="FondoNavegadorOscuro">#2C2C2E</Color>
    <Color x:Key="Separador">#D1D1D6</Color>
    <Color x:Key="SeparadorOscuro">#38383A</Color>
    <Color x:Key="Acento">#0A84FF</Color>
    <Color x:Key="TextoTenue">#8E8E93</Color>

    <Style x:Key="RegionBarra" TargetType="Grid">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource FondoBarra}, Dark={StaticResource FondoBarraOscuro}}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="RegionCanvas" TargetType="Grid">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource FondoCanvas}, Dark={StaticResource FondoCanvasOscuro}}" />
    </Style>

    <Style x:Key="RegionInspector" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource FondoInspector}, Dark={StaticResource FondoInspectorOscuro}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Separador}, Dark={StaticResource SeparadorOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="RegionNavegador" TargetType="Grid">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource FondoNavegador}, Dark={StaticResource FondoNavegadorOscuro}}" />
    </Style>

    <Style x:Key="EtiquetaSeccion" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextoTenue}" />
    </Style>

    <Style x:Key="EtiquetaEstado" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextoTenue}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

</ResourceDictionary>
